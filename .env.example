# Copy to `.env` for local development (gitignored). Next.js loads `.env` automatically.
# Do not commit real secrets.

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Optional; defaults to http://localhost:3000 in development
AUTH_URL=http://localhost:3000

# GitHub OAuth App (https://github.com/settings/developers)
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cursor API key is NOT set here. Enter it in the meeting setup UI; it is stored
# on the Auth.js session. Get a key at https://cursor.com/dashboard/integrations
# and connect the Cursor GitHub App to the repos you want to discuss.
